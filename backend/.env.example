# Copy to .env and fill in. .env is gitignored — never commit the token.
# Create a token at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_SITE=jakenm.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=

# Slack — optional. Leave blank and the tool posts to Jira only.
# User OAuth Token (xoxp-...) from https://api.slack.com/apps: OAuth & Permissions
# -> User Token Scopes -> chat:write, then reinstall the app. The message then
# comes from you, not from an app. You must be a member of the channel.
SLACK_USER_TOKEN=
# Fallback only. A bot token posts under the app's name with Slack's APP tag.
SLACK_BOT_TOKEN=
SLACK_REPORT_CHANNEL=
SLACK_REPORT_MESSAGE=em báo cáo rồi nha chị

PORT=4180
CORS_ORIGINS=http://localhost:5180

# "React slack": channels scanned for Jame's "em đã tạo sub-task" messages,
# and his Slack user id. Needs these USER token scopes on top of chat:write —
# groups:history (private channels), reactions:read, reactions:write.
SLACK_REACT_CHANNELS=C0ATW99QH9B,C0BJQ7QFPPT
SLACK_REACT_USER=U0A2PE5Q0LB
